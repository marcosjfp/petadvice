# Development is the default. Production requires a stable random JWT secret.
APP_ENV=development
# JWT_SECRET_KEY=generate-a-random-value-of-at-least-32-characters

# Explicit trusted browser origins. Cookie-based mutations validate Origin.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional. SQLite is suitable for local development only.
# DATABASE_URL=sqlite:///./petadvice.db

# The frontend defaults to /api through Vite's development proxy.
# In production, route /api/* to the backend on the same origin (strip /api).
# VITE_API_BASE_URL=/api
