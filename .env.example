# Copy to .env for native development. Never commit actual environment files.
APP_ENV=development
DATABASE_URL=sqlite:///./petadvice.db
# Set a stable random value for persistent local login across restarts.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET_KEY=your-generated-secret
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PUBLIC_WEB_URL=http://127.0.0.1:5173
TRUSTED_HOSTS=localhost,127.0.0.1
RATE_LIMIT_STORAGE_URI=memory://
GUEST_RETENTION_HOURS=24
REQUIRE_EMAIL_VERIFICATION=false
MAIL_BACKEND=file
MAIL_DIRECTORY=.mail
# Generate each encryption key separately:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MAIL_ENCRYPTION_KEY=
# BACKUP_ENCRYPTION_KEY is read by the backup/restore tools; keep it separately.
BACKUP_ENCRYPTION_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
SMTP_SSL=false
PRIVACY_OPERATOR=
PRIVACY_EMAIL=
PRIVACY_POLICY_URL=
PRIVACY_POLICY_VERSION=beta-2026-10-09

# Container deployment: separate administrator/app credentials, NEVER the same.
# POSTGRES_ADMIN_PASSWORD=
# POSTGRES_PASSWORD=
# DATABASE_URL=postgresql+psycopg://petadvice_app:APP_PASSWORD@db:5432/petadvice
# RATE_LIMIT_STORAGE_URI=redis://redis:6379/0
# PUBLIC_WEB_URL=https://YOUR_DOMAIN
# CORS_ORIGINS=https://YOUR_DOMAIN
# TRUSTED_HOSTS=YOUR_DOMAIN,localhost,127.0.0.1
# SITE_ADDRESS=YOUR_DOMAIN
# WEB_BIND_HOST=0.0.0.0
# WEB_HTTP_PORT=80
# WEB_HTTPS_PORT=443
# PROXY_IP=172.30.240.10
# PROXY_SUBNET=172.30.240.0/24
# PETADVICE_IMAGE_TAG=YOUR_RELEASE_ID
# Production requires APP_ENV=production, SMTP/TLS, operator/contact/policy URL,
# PostgreSQL with non-admin app credentials, shared Redis and stable keys.

# Vercel uses scheduled jobs and Resend; see docs/vercel-release.md and
# .env.vercel.example. Defaults above retain the local/Docker worker.
DEPLOYMENT_MODE=worker
DIRECT_DATABASE_URL=
RESEND_API_KEY=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
QSTASH_URL=https://qstash-eu-central-1.upstash.io
