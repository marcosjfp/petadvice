# Reference only: enter actual values in Vercel Environment Variables.
# Separate Preview and Production resources; never use these placeholders.
APP_ENV=production
DEPLOYMENT_MODE=scheduled
DATABASE_URL=postgresql+psycopg://petadvice_app:REPLACE@YOUR_POOLED_HOST/neondb?sslmode=require
# Use this only in the controlled migration environment, not the function.
# DIRECT_DATABASE_URL=postgresql+psycopg://petadvice_app:REPLACE@YOUR_DIRECT_HOST/neondb?sslmode=require
JWT_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
PUBLIC_WEB_URL=https://YOUR_PROJECT.vercel.app
CORS_ORIGINS=https://YOUR_PROJECT.vercel.app
TRUSTED_HOSTS=YOUR_PROJECT.vercel.app
RATE_LIMIT_STORAGE_URI=rediss://default:REPLACE@YOUR_REDIS_HOST:6379/0
GUEST_RETENTION_HOURS=24
MAIL_BACKEND=resend
MAIL_ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY
RESEND_API_KEY=REPLACE
# Shared sender setting; Resend uses it as the From address.
SMTP_FROM=PETAdvice <hello@YOUR_VERIFIED_DOMAIN>
QSTASH_URL=https://qstash-eu-central-1.upstash.io
QSTASH_TOKEN=REPLACE
QSTASH_CURRENT_SIGNING_KEY=REPLACE
QSTASH_NEXT_SIGNING_KEY=REPLACE
PRIVACY_OPERATOR=REPLACE
PRIVACY_EMAIL=REPLACE
PRIVACY_POLICY_URL=https://YOUR_POLICY_URL
PRIVACY_POLICY_VERSION=REPLACE_WITH_PUBLISHED_POLICY_VERSION
# Optional for a preview protected by Vercel Deployment Protection:
# VERCEL_AUTOMATION_BYPASS_SECRET=REPLACE_WITH_PROJECT_BYPASS_SECRET
